{
  "name": "tempo-language",
  "displayName": "Tempo",
  "description": "Syntax highlighting for the Tempo programming language.",
  "version": "0.1.0",
  "publisher": "RichardPhillip",
  "author": {
    "name": "Richard Phillip",
    "email": "richard@eigenform.art",
    "url": "https://eigenform.art"
  },
  "license": "MIT",
  "homepage": "https://eigenform.art",
  "repository": {
    "type": "git",
    "url": "https://github.com/richard-phillip/tempo-language"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "tempo",
    "syntax",
    "highlighting"
  ],
  "contributes": {
    "languages": [
      {
        "id": "tempo",
        "aliases": ["Tempo", "tempo"],
        "extensions": [".tempo"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "tempo",
        "scopeName": "source.tempo",
        "path": "./syntaxes/tempo.tmLanguage.json"
      }
    ]
  }
}
